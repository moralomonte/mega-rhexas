# Public site for the apex and www. Imported by deploy/Caddyfile.host.
# Static files live in this repo at site/ and on the droplet at /opt/mega-rhexas/site.
# Caddy serves them. It does not proxy these hostnames to the coordinator.

(megarhexas_site) {
	encode gzip zstd
	root * /opt/mega-rhexas/site
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# style-src allows inline style attributes because the sector bars set width from script.
		# script-src stays 'self': the pages load only /js/*.js.
		Content-Security-Policy "default-src 'self'; connect-src 'self' https://api.megarhexas.com https://api.github.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	@assets path /css/* /js/* /img/* /favicon.svg
	header @assets Cache-Control "public, max-age=86400"
	@pages path *.html /
	header @pages Cache-Control "no-cache"
	route {
		@favicon path /favicon.ico
		rewrite @favicon /favicon.svg
		try_files {path} {path}.html {path}/index.html
		file_server
	}
	handle_errors {
		@404 expression `{err.status_code} == 404`
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}
}

megarhexas.com, www.megarhexas.com {
	import megarhexas_site
}
